# ==========================================
# MeroPathsala Server Environment Template (SANDBOX ONLY)
# ==========================================

# Server Configuration
PORT=8080
MONGO_URI=mongodb://localhost:27017/meropathsala
SECRET_KEY=replace_with_a_secure_random_jwt_secret
CLIENT_URL=http://localhost:5173

# ==========================================
# eSewa ePay V2 Payment Gateway (SANDBOX ONLY)
# ==========================================
# MeroPathsala is strictly configured for eSewa SANDBOX testing.
# Non-sandbox or production endpoints are rejected by the server.

# Official eSewa Sandbox Form POST URL
ESEWA_GATEWAY_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form

# Official eSewa Sandbox Server-to-Server Transaction Status URL
ESEWA_STATUS_CHECK_URL=https://uat.esewa.com.np/api/epay/transaction/status/

# Official eSewa Sandbox Merchant Product Code
ESEWA_PRODUCT_CODE=EPAYTEST

# Official eSewa Sandbox Secret Key (HMAC-SHA256) - Keep on backend only
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q

# Callback URLs for redirecting the student's browser after payment
ESEWA_SUCCESS_URL=http://localhost:5173/payment/esewa/success
ESEWA_FAILURE_URL=http://localhost:5173/payment/esewa/failure

# ==========================================
# Third-Party Integrations (Cloudinary & AI)
# ==========================================
CLOUD_NAME=your_cloudinary_cloud_name
API_KEY=your_cloudinary_api_key
API_SECRET=your_cloudinary_api_secret

OPENAI_API_KEY=your_openai_api_key
ENROLLMENT_WEBHOOK_SECRET=meropathsala_google_form_secret_2026
